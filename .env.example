# ============================================================
# ローカル実行用の設定ファイル
# このファイルを .env という名前でコピーして値を埋めてください。
# .env は .gitignore で除外されるためリポジトリには載りません。
# GitHub Actions で動かす場合は、同じ4つを GitHub Secrets に登録します。
# ============================================================

# 楽天ウェブサービスのアプリID（https://webservice.rakuten.co.jp/app/list で発行）
# 空のままでも動きます（その場合は楽天トラベルのページを直接読む方式に自動で切り替わります）
RAKUTEN_APPLICATION_ID=

# 送信元 Gmail アドレス
GMAIL_ADDRESS=your-address@gmail.com

# Gmail の「アプリパスワード」16桁（通常のログインパスワードでは送信できません）
# 空白は入れても入れなくても構いません（自動で除去します）
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# 通知先メールアドレス（Yahoo!メール）。カンマ区切りで複数指定できます。
NOTIFY_TO=your-address@yahoo.co.jp
